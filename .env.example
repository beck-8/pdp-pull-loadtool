# Wallet for signing extraData (EIP-712 over FWSS). Mandatory.
PRIVATE_KEY=

# Target Curio SP — by on-chain provider ID. Recommended.
# This single value auto-discovers CURIO_URL (= serviceURL) AND PAYEE_ADDRESS
# from the SP registry. Find IDs at:
#   - Curio GUI of the SP, or
#   - https://calibration.filfox.info -> contracts -> ServiceProviderRegistry
PROVIDER_ID=

# OR: explicit Curio URL (overrides discovery from PROVIDER_ID).
# CURIO_URL=https://your-curio.example.com

# OR: explicit payee (overrides discovery from PROVIDER_ID).
# PAYEE_ADDRESS=0x...

# Optional: target an existing dataset for this signer. If left as 0, the
# loader queries FWSS for any existing dataset owned by your address and
# uses the first one (preferred). If none exist, it creates a new dataset
# using the resolved payee.
DATA_SET_ID=0

# Network — calibration or mainnet.
NETWORK=calibration

# Source server config — Curio will GET ${SOURCE_PUBLIC_URL}/piece/{cid}?i=&size=
# Must be reachable by Curio AND satisfy Curio's source validation:
#   - HTTPS (unless Curio runs with CURIO_PULL_ALLOW_INSECURE=1)
#   - NOT localhost / private IP
# Put behind Caddy / Cloudflare Tunnel / ngrok for HTTPS.
SOURCE_PUBLIC_URL=https://source.example.com

# Source server bind (the process listens here; reverse-proxy fronts it).
SOURCE_BIND=0.0.0.0
SOURCE_PORT=8080

# Deterministic piece derivation salt (32-byte hex). Loader + source MUST agree.
# Change to invalidate previous runs' caches in Curio.
DERIVE_SALT=0xc0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ff
