# Wallet for signing extraData (EIP-712 over FWSS). Mandatory for loader.
PRIVATE_KEY=

# Curio node endpoint (Calibration). Loader POSTs /pdp/piece/pull here.
CURIO_URL=https://your-curio.example.com

# Source server config — Curio will GET ${SOURCE_PUBLIC_URL}/piece/{cid}?salt=&i=&size=
# Must be reachable by Curio AND must satisfy Curio's source validation:
#   - HTTPS (unless Curio runs with CURIO_PULL_ALLOW_INSECURE=1)
#   - NOT localhost / private IP
# Typically: put behind Caddy / Cloudflare Tunnel / ngrok.
SOURCE_PUBLIC_URL=https://source.example.com

# Source server bind (the process listens here; reverse-proxy fronts it).
SOURCE_BIND=0.0.0.0
SOURCE_PORT=8080

# Deterministic piece derivation salt (32-byte hex). Loader + source MUST agree.
# Change to invalidate previous runs' caches in Curio.
DERIVE_SALT=0xc0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ffeec0ff

# Optional: target an existing dataset. Omit / set 0 to create new.
DATA_SET_ID=0

# Optional: payee address (service provider) — required when creating new dataset.
PAYEE_ADDRESS=
